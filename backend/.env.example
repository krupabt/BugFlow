# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bugflow_db

# Flask & JWT Security Keys
SECRET_KEY=bugflow-flask-secret-key-change-this
JWT_SECRET_KEY=bugflow-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ==========================================
# GitHub Integration & CI/CD (Milestone 3)
# ==========================================
# Generate token with 'repo' and 'workflow' scopes at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=krupabt
GITHUB_REPO=BugFlow
GITHUB_WEBHOOK_SECRET=
GITHUB_ENCRYPTION_KEY=
